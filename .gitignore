# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editors
.vscode/
.idea/

# python bytecode aus mitgelieferten Skill-Skripten
__pycache__/
*.pyc

# temporaerer Export fuer die externe Sicherheitspruefung
# (dupliziert nur die ohnehin versionierten Skills)
/security-review-export/
/security-review-export.zip

# Hero-Video.
#
# hero.mp4 und hero-original-nofaststart.mp4 sind je rund 140 MB. GitHub
# weist einzelne Dateien ueber 100 MB grundsaetzlich zurueck — ein Push
# waere gescheitert. Ausserdem laesst sich eine einmal committete Binaerdatei
# ohne Umschreiben der Historie nicht mehr aus dem Repository entfernen.
#
# Grosse Mediendateien gehoeren nicht in die Codeverwaltung. Sobald das Video
# neu exportiert ist (2,5-4 Mbit/s, Zielgroesse 8-12 MB), kann es entweder
# hier aufgenommen oder besser ueber Vercel Blob bzw. einen CDN ausgeliefert
# werden.
#
# Ohne die Datei zeigt der Hero das ohnehin immer gerenderte Standbild —
# die Seite bleibt vollstaendig, nur ohne Bewegtbild.
/public/video/
